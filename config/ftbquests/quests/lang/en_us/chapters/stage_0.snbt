	quest.1D77FC3C44DE2076.title: "Beat Brock"
	quest.2142C565D5E72B2B.quest_desc: [
		"Progress is measured in &6stages&r: beat a gym leader to reach the next one."
		"Each stage unlocks Pokémon you're allowed to catch (legendaries come in tiers) and items that start turning up in structure chests for you."
		""
		"Your Pokémon can't level past your &elevel cap&r: the ace level of your next unbeaten key trainer."
		"Press &aL&r to see your stages in the Campfiremons League advancement tab."
	]
