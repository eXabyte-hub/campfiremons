	quest.480E2472874EE104.quest_desc: [
		"Erika, the Celadon City gym leader, is your next badge. There are no key fights before Erika: you can battle as soon as you've beaten Lt. Surge."
		""
		"Level cap until you win: &e44&r."
		"Type &a/gymmap&r for directions to the nearest &eCeladon Gym&r."
		""
		"Winning earns the &eRainbow Badge&r and Stage 4, and opens &eStage 4: Marsh Badge&r."
	]
	quest.480E2472874EE104.quest_subtitle: "No key fights"
	quest.480E2472874EE104.title: "The Road to Erika"
	quest.3EC89ECC138766E7.quest_desc: [
		"Brock, the Pewter City gym leader, is your first badge. There are no key fights before him."
		""
		"Level cap until you win: &e15&r."
		"He waits in the &ePewter Gym&r: type &a/gymmap&r for directions to the nearest one."
		""
		"Beating him earns the &eBoulder Badge&r and Stage 1, and opens &eStage 1: Cascade Badge&r."
	]
