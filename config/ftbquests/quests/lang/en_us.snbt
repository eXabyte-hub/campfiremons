	quest.7B5B336A532C2F19.title: "The Elite Four"
	quest.7B5B336A532C2F19.quest_subtitle: "Key fight, Lv85"
	quest.7B5B336A532C2F19.quest_desc: [
		"Beat all four, in any order. Each one has a Lv85 team, so your level cap stays at &e85&r until the Champion."
		""
		"Where they spawn, 25 to 70 blocks from you:"
		"- &eLorelei&r: cold biomes"
		"- &eBruno&r: caves, plateaus, mountains"
		"- &eAgatha&r: spooky biomes, swamps"
		"- &eLance&r: mountains, peaks"
	]
	quest.50C54A7D14B8223B.title: "Pasture Jobs"
	quest.50C54A7D14B8223B.quest_subtitle: "Put your Pokémon to work"
	quest.50C54A7D14B8223B.quest_desc: [
		"Pokémon in a &ePasture&r take on jobs that suit their type, ability or moves: farming, keeping furnaces burning, fishing, digging up treasure and more."
		""
		"They work the blocks within 8 blocks of the pasture (5 up or down) and bring what they make to a chest or barrel nearby. A Pokémon does any job it qualifies for, and each quest here is one kind of worker."
	]
	quest.7515C22668D57446.title: "Drop-off"
	quest.7515C22668D57446.quest_subtitle: "A chest by the pasture"
	quest.7515C22668D57446.quest_desc: [
		"Workers carry what they make to a container near the pasture: a chest, barrel or the like, within 8 blocks of it and 5 up or down. Keep some room in it."
	]
	quest.2DA862339A2FC395.title: "Worker Inventory Selector"
	quest.2DA862339A2FC395.quest_subtitle: "Choose the drop-off"
	quest.2DA862339A2FC395.quest_desc: [
		"Right-click a container with it to make it the drop-off for pastures in range; right-click again to undo. Pastures with no chosen container use any one nearby."
		""
		"Crafted from paper, a red apricorn and string."
	]
	quest.2E236DC362C4FD7E.title: "Day Off"
	quest.2E236DC362C4FD7E.quest_subtitle: "Stop a worker"
	quest.2E236DC362C4FD7E.quest_desc: [
		"Open a pastured Pokémon's interaction wheel and choose &eRest&r to stop it working. Choose it again to send it back to work."
	]
	quest.3A838978DB25F12E.title: "Farmers"
	quest.3A838978DB25F12E.quest_subtitle: "Grass types"
	quest.3A838978DB25F12E.quest_desc: [
		"Harvest fully grown crops (wheat, carrots, potatoes, beetroot, most modded crops, revival herbs, vivichokes, medicinal leeks), berries, sweet berry and galarica nut bushes, mistleaf and verdroot, and leave them planted to grow again."
		""
		"Hearty grains are picked whole, so replant those yourself."
	]
	quest.7280A5173E85FE63.title: "Pollinators"
	quest.7280A5173E85FE63.quest_subtitle: "Bug types"
	quest.7280A5173E85FE63.quest_desc: [
		"Pollinate: crops, berries and apricorns within 8 blocks of their pasture grow about twice as fast. Watch for green sparkles. One Bug type per pasture is enough; more don't add more."
		""
		"They also pick ripe apricorns and leave the tree to grow more."
	]
	quest.20C1FF4D95DA49F1.title: "Mint Growers"
	quest.20C1FF4D95DA49F1.quest_subtitle: "Fairy types"
	quest.20C1FF4D95DA49F1.quest_desc: [
		"Pick grown mints and leave them planted."
	]
	quest.76AE0A817ACCB9CD.title: "Nether Wart Farmers"
	quest.76AE0A817ACCB9CD.quest_subtitle: "Ghost types"
	quest.76AE0A817ACCB9CD.quest_desc: [
		"Harvest grown nether wart and leave it planted."
	]
	quest.5CC5F49086DB9025.title: "Voltaconia Pickers"
	quest.5CC5F49086DB9025.quest_subtitle: "Electric types"
	quest.5CC5F49086DB9025.quest_desc: [
		"Pick voltaconia and replant its seed."
	]
	quest.2379373969D88579.title: "Tidy Minds"
	quest.2379373969D88579.quest_subtitle: "Psychic types"
	quest.2379373969D88579.quest_desc: [
		"Pick lucibell and replant its seed, and pick up items lying on the ground around the pasture."
	]
	quest.24D280DDB5B44A03.title: "Stokers"
	quest.24D280DDB5B44A03.quest_subtitle: "Fire types"
	quest.24D280DDB5B44A03.quest_desc: [
		"Keep furnaces, smokers and blast furnaces burning while they have something to smelt, and fill empty cauldrons with lava."
	]
	quest.1EDE29F1AE4E1FB7.title: "Water Workers"
	quest.1EDE29F1AE4E1FB7.quest_subtitle: "Water types"
	quest.1EDE29F1AE4E1FB7.quest_desc: [
		"Fill empty cauldrons with water, keep farmland wet and put out fires. Standing in water, they also fish: a catch every minute and a half."
	]
	quest.1FE4CACDE4168E25.title: "Snow Makers"
	quest.1FE4CACDE4168E25.quest_subtitle: "Ice types"
	quest.1FE4CACDE4168E25.quest_desc: [
		"Fill empty cauldrons with powder snow."
	]
	quest.4D1922389574219A.title: "Brewing Helpers"
	quest.4D1922389574219A.quest_subtitle: "Dragon types"
	quest.4D1922389574219A.quest_desc: [
		"Top up the fuel of brewing stands, so you need less blaze powder."
	]
	quest.1366BF3ACD6A3B81.title: "Pickup"
	quest.1366BF3ACD6A3B81.quest_subtitle: "The Pickup ability"
	quest.1366BF3ACD6A3B81.quest_desc: [
		"A Pokémon with Pickup finds something every three and a half minutes: held items, Poké Balls, evolution stones, EXP candy, healing items, type gems or apricorn seeds."
	]
	quest.3E86580FE4E2DAD6.title: "Diggers"
	quest.3E86580FE4E2DAD6.quest_subtitle: "Ground types"
	quest.3E86580FE4E2DAD6.quest_desc: [
		"Dig in dirt, gravel, mud, coarse dirt or rooted dirt with open air above it, turning up raw ores and other finds every four minutes."
	]
	quest.3A39DF7183414970.title: "Amethyst Miners"
	quest.3A39DF7183414970.quest_subtitle: "Rock types"
	quest.3A39DF7183414970.quest_desc: [
		"Break grown amethyst clusters. Budding amethyst grows new ones."
	]
	quest.16D3AF9F0678F870.title: "Tumblestone Miners"
	quest.16D3AF9F0678F870.quest_subtitle: "Steel types"
	quest.16D3AF9F0678F870.quest_desc: [
		"Break grown tumblestone, black tumblestone and sky tumblestone clusters. They grow back from the budding block left behind."
	]
	quest.41552B074287F72C.title: "Divers"
	quest.41552B074287F72C.quest_subtitle: "Knows Dive"
	quest.41552B074287F72C.quest_desc: [
		"A Pokémon that knows Dive, standing in water, brings up treasure every three and a half minutes."
	]
	quest.5478B7ABFE90EFFC.title: "Fletchers"
	quest.5478B7ABFE90EFFC.quest_subtitle: "Poison types"
	quest.5478B7ABFE90EFFC.quest_desc: [
		"Pick up arrows lying around the pasture and turn them into Arrows of Poison."
	]
	quest.7860633CA57FF05E.title: "Healers"
	quest.7860633CA57FF05E.quest_subtitle: "Knows a healing move"
	quest.7860633CA57FF05E.quest_desc: [
		"A Pokémon that knows Wish, Soft-Boiled, Moonlight, Recover, Roost, Heal Bell, Aromatherapy, Synthesis, Rest or Life Dew gives players near the pasture a short Regeneration boost."
	]
	quest.635F7E2F04C1B105.title: "Rain Dancer"
	quest.635F7E2F04C1B105.quest_subtitle: "Slowpoke"
	quest.635F7E2F04C1B105.quest_desc: [
		"A pastured Slowpoke calls rain at most every ten minutes. That is rain for the whole world, so check with your friends first."
	]
	quest.29BACF09B9D10613.title: "Honey Makers"
	quest.29BACF09B9D10613.quest_subtitle: "Combee and Vespiquen"
	quest.29BACF09B9D10613.quest_desc: [
		"Fill beehives with honey and collect honeycombs from full ones. Three honeycombs and a glass bottle make a honey bottle."
	]
	quest.6FB591514A07A6AF.title: "Ender Pearls"
	quest.6FB591514A07A6AF.quest_subtitle: "Knows Teleport"
	quest.6FB591514A07A6AF.quest_desc: [
		"A Pokémon that knows Teleport fetches an &eEnder Pearl&r from an &eEnder Chest&r near the pasture every two or three minutes. Walkers like Natu and Ralts work more steadily than floaty Abra."
	]
	quest.546ECBC3A98A93F7.title: "Ametrine Armor"
	quest.546ECBC3A98A93F7.quest_subtitle: "All four pieces, 20 armor"
	quest.17054473EC6F3B06.title: "Aquamarine Armor"
	quest.17054473EC6F3B06.quest_subtitle: "All four pieces, 20 armor"
	quest.232DEE40066FAEAF.title: "Citrine Armor"
	quest.232DEE40066FAEAF.quest_subtitle: "All four pieces, 20 armor"
	quest.25D22D69F34E2AD7.title: "Jade Armor"
	quest.25D22D69F34E2AD7.quest_subtitle: "All four pieces, 20 armor"
	quest.66C6B7D58A1B4ECA.title: "Peridot Armor"
	quest.66C6B7D58A1B4ECA.quest_subtitle: "All four pieces, 20 armor"
	quest.6120DA685E3606C7.title: "Ruby Armor"
	quest.6120DA685E3606C7.quest_subtitle: "All four pieces, 20 armor"
	quest.485A36CEE175F8E8.title: "Sapphire Armor"
	quest.485A36CEE175F8E8.quest_subtitle: "All four pieces, 20 armor"
	quest.1D93F6922DE04567.title: "Topaz Armor"
	quest.1D93F6922DE04567.quest_subtitle: "All four pieces, 20 armor"
	quest.0003E6E0530C6E98.quest_desc: [
		"These key trainers stand between you and Sabrina, in this order (the quests in line to the right):"
		"&e- Boss Giovanni (Lv46)&r: badlands, wastelands, savannas"
		"&e- Rival Terry (Lv55)&r: plains, sparse grassland, rare biomes, End cities"
		"&e- Rocket Admins Archer \\& Ariana (Lv55)&r: the Nether, badlands, wastelands, savannas"
		"&e- Boss Giovanni (Lv56)&r: the Nether, badlands, wastelands, savannas"
		""
		"Each one you beat raises your level cap. They come one at a time, in this order: only the next one you haven't beaten can appear, 25 to 70 blocks from you while you are in or near the biomes listed, and you get a chat message when one turns up."
	]
	quest.0003E6E0530C6E98.quest_subtitle: "Key fights"
	quest.0003E6E0530C6E98.title: "Before Sabrina"
	quest.01F859EDB8C5D546.quest_desc: [
		"It now turns up (once) in structure chests: dungeons, temples, shipwrecks, ruins, strongholds and more."
		"Chests are per player, so check every one you pass."
	]
	quest.01F859EDB8C5D546.quest_subtitle: "Explore structure chests"
	quest.01F859EDB8C5D546.title: "Find the Rusted Shield"
	quest.026F1DF4C892C8EB.quest_desc: [
		"Legendaries appear as rare spawns and at Legendary Monuments shrines."
	]
	quest.026F1DF4C892C8EB.quest_subtitle: "A hint"
	quest.026F1DF4C892C8EB.title: "Out Exploring"
	quest.0440240B5085D636.quest_desc: [
		"Any level is fine: if you can weaken it, you can catch it."
	]
	quest.0440240B5085D636.quest_subtitle: "Catch 5 Pokémon"
	quest.0440240B5085D636.title: "Building a Team"
	quest.056CC15916CA9B0B.quest_desc: [
		"These key trainers stand between you and Champion Terry, in this order (the quests in line to the right):"
		"&e- Rival Terry (Lv81)&r: plains, sparse grassland, rare biomes, End cities"
		"&e- Trainer Brendan (Lv82)&r: plains, sparse grassland, rare biomes, cave biomes underground"
		"&e- Elite Four Agatha (Lv85)"
		"&e- Elite Four Bruno (Lv85)"
		"&e- Elite Four Lance (Lv85)"
		"&e- Elite Four Lorelei (Lv85)"
		""
		"Each one you beat raises your level cap. They come one at a time, in this order: only the next one you haven't beaten can appear, 25 to 70 blocks from you while you are in or near the biomes listed, and you get a chat message when one turns up."
	]
	quest.056CC15916CA9B0B.quest_subtitle: "Key fights"
	quest.056CC15916CA9B0B.title: "Before Champion Terry"
	quest.0612A68FC7008D19.quest_desc: [
		"Every legendary tier is open. Giovanni brings Mega Mewtwo Y; you can bring yours."
	]
	quest.0612A68FC7008D19.quest_subtitle: "Catch a mythical or box legend"
	quest.0612A68FC7008D19.title: "Myths and Legends"
	quest.06CA7CC483D0C8F4.quest_desc: [
		"Lt. Surge waits in the &eVermilion Gym&r."
		"Type &a/gymmap&r for directions to the nearest one, with a map."
		"You can also challenge Lt. Surge in Vermilion's gym in the Kanto cities: talk to them there."
		""
		"Your whole party must be at or under your level cap to battle."
		"Level cap until you win: &e34&r (Lt. Surge's strongest Pokémon)."
	]
	quest.06CA7CC483D0C8F4.quest_subtitle: "Reach Stage 3"
	quest.06CA7CC483D0C8F4.title: "Beat Lt. Surge"
	quest.07770E338AC86117.quest_desc: [
		"Throw a Poké Ball at a wild Pokémon, or battle it first to make the catch easier."
	]
	quest.07770E338AC86117.quest_subtitle: "Catch any Pokémon"
	quest.07770E338AC86117.title: "First Catch"
	quest.080EFFF2C23BE2C4.quest_desc: [
		"Koga waits in the &eFuchsia Gym&r."
		"Type &a/gymmap&r for directions to the nearest one, with a map."
		"You can also challenge Koga in Fuchsia's gym in the Kanto cities: talk to them there."
		""
		"Your whole party must be at or under your level cap to battle."
		"Level cap until you win: &e68&r (Koga's strongest Pokémon)."
	]
	quest.080EFFF2C23BE2C4.quest_subtitle: "Reach Stage 6"
	quest.080EFFF2C23BE2C4.title: "Beat Koga"
	quest.1024104E87D76C98.quest_desc: [
		"Your boxes, from any PC: 60 boxes per PC, plenty of room for a living Pokédex."
	]
	quest.1024104E87D76C98.quest_subtitle: "Get a PC"
	quest.1024104E87D76C98.title: "PC"
	quest.10A6D6C341C9DE6F.quest_desc: [
		"It now turns up (once) in structure chests: dungeons, temples, shipwrecks, ruins, strongholds and more."
		"Chests are per player, so check every one you pass."
	]
	quest.10A6D6C341C9DE6F.quest_subtitle: "Explore structure chests"
	quest.10A6D6C341C9DE6F.title: "Find the Z-Ring"
	quest.11AD944950E1ABD5.quest_desc: ["&r&rBuy a &eBeast Memory&r in the Battle Tower's BP shop and use it to summon Type: Null."]
	quest.11AD944950E1ABD5.quest_subtitle: "Catchable from Stage 5"
	quest.11AD944950E1ABD5.title: "Type: Null"
	quest.134977A1494685F1.quest_desc: [
		"&eBeast Balls&r and &eDream Balls&r work now."
	]
	quest.134977A1494685F1.quest_subtitle: "Catch an Ultra Beast or Paradox Pokémon"
	quest.134977A1494685F1.title: "Beyond the Wormhole"
	quest.1445C66480DA6C42.quest_subtitle: "Catchable from Stage 6"
	quest.1445C66480DA6C42.title: "Brute Bonnet"
	quest.148178E905BD69A8.quest_subtitle: "All four pieces"
	quest.148178E905BD69A8.title: "Shiny Flareon Armor"
	quest.14F86FB31E011ACE.quest_desc: [
		"These key trainers stand between you and Clair, in this order (the quests in line to the right):"
		"&e- Rocket Admin Archer (Lv79)&r: the Nether, End cities, badlands, wastelands, savannas"
		"&e- Rocket Admin Ariana (Lv79)&r: the Nether, End cities, badlands, wastelands, savannas"
		"&e- Boss Giovanni (Lv80)&r: the Nether, End cities, badlands, wastelands, savannas"
		""
		"Each one you beat raises your level cap. They come one at a time, in this order: only the next one you haven't beaten can appear, 25 to 70 blocks from you while you are in or near the biomes listed, and you get a chat message when one turns up."
	]
	quest.14F86FB31E011ACE.quest_subtitle: "Key fights"
	quest.14F86FB31E011ACE.title: "Before Clair"
	quest.1540D0C2EC054A1F.quest_subtitle: "Catchable from Stage 5"
	quest.1540D0C2EC054A1F.title: "Virizion"
	quest.15917847BB550E92.title: "Sail Fossil"
	quest.16420C4B0E0C987D.quest_subtitle: "Win 1 raid"
